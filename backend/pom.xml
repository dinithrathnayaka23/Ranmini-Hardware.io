<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>lk.ranminihardware</groupId>
  <artifactId>pos-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>Ranmini Hardware POS Backend</name>
  <description>Point-of-sale and inventory service for Ranmini Hardware</description>

  <properties>
    <java.version>21</java.version>
    <springdoc.version>2.8.13</springdoc.version>
    <testcontainers.version>1.20.6</testcontainers.version>
    <jjwt.version>0.12.6</jjwt.version>
    <openpdf.version>2.0.3</openpdf.version>
  </properties>

  <dependencies>
    <!-- Web layer. The service is a REST API only; no server-side views. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- MongoDB. Chosen by the client for horizontal scalability; every query
         in this service is written against an index declared in MongoIndexes. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-mongodb</artifactId>
    </dependency>

    <!-- Bean Validation on every request body and query parameter. The API is
         the last line of defence: the browser's checks are a convenience. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Health and metrics endpoints, so the till can be monitored in the shop. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Settings are read on nearly every request and change perhaps monthly,
         so they are cached rather than fetched from Mongo each time. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- Authentication and authorisation. Brings the password encoder with it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>

    <!-- Password reset emails. Sent through whatever SMTP relay the shop
         configures; with none configured the link is logged instead, so the
         flow is testable without credentials. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>

    <!-- Stateless JWT sessions. Signed tokens rather than server-side session
         state, so the API stays horizontally scalable: any instance can verify
         a token without a shared session store. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Browsable API docs at /swagger-ui.html, so the frontend work that comes
         next has something concrete to read. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- PDF generation for the inventory and sales reports the owner prints
         and files. Server-side rather than in the browser for two reasons: the
         inventory export covers the whole catalogue rather than the page on
         screen, and the shop's letterhead comes from settings that only the
         server can read. OpenPDF is LGPL/MPL, used unmodified as a library. -->
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>

    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Tests run against a real MongoDB in Docker rather than a fake. The
         behaviour that matters most here — atomic conditional stock decrements
         and aggregation pipelines — is precisely what an in-memory stub gets
         wrong. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>mongodb</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>

      <!--
        Two test phases, on purpose.

        `mvn test` runs only the fast unit tests (*Test), so the loop while
        writing code stays quick and needs nothing installed. `mvn verify` also
        runs the integration tests (*IT), which start a real MongoDB through
        Testcontainers and therefore need Docker running.

        The split matters because the integration tests are the ones that catch
        the bugs that matter here — an atomic update that is not atomic, a
        unique index that does not reject — and those cannot be checked without
        a real database. Making them opt-in keeps them from being deleted for
        being slow.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <!--
            Run against the plain compiled classes, not the repackaged jar.
            Spring Boot's repackage step moves classes under BOOT-INF/classes,
            which the test classloader cannot read: without this, discovery
            fails with a NoClassDefFoundError for the application's own types.
          -->
          <classesDirectory>${project.build.outputDirectory}</classesDirectory>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <!-- Keeps parameter names in the bytecode, which is what lets
                 Spring bind @RequestParam without repeating every name. -->
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
