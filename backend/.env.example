# Copy to .env (git-ignored) and fill in. Never commit real credentials.

# MongoDB connection string, including database name.
# Local development via docker compose:
#   mongodb://localhost:27017/ranmini_pos
# MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>/ranmini_pos?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ranmini_pos

# Port the API listens on.
SERVER_PORT=8080

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to DEBUG to see the queries this service issues.
APP_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Signing key for session tokens. At least 32 characters; the service refuses to
# start without it. Generate one with:
#   openssl rand -base64 48
RANMINI_AUTH_JWT_SECRET=

# How long a signed-in session lasts before the token must be refreshed.
RANMINI_AUTH_ACCESS_MINUTES=30
RANMINI_AUTH_REFRESH_DAYS=7

# ---------------------------------------------------------------------------
# The two owner accounts
#
# Created only on a fresh database, and never overwritten afterwards. Leave the
# passwords blank and a strong one is generated and printed once at first
# startup, so nothing is ever hard-coded in the repository.
# ---------------------------------------------------------------------------
RANMINI_ADMIN_PRIMARY_USERNAME=owner
RANMINI_ADMIN_PRIMARY_NAME=Shop Owner
RANMINI_ADMIN_PRIMARY_EMAIL=owner@ranminihardware.lk
RANMINI_ADMIN_PRIMARY_PASSWORD=

RANMINI_ADMIN_SECONDARY_USERNAME=manager
RANMINI_ADMIN_SECONDARY_NAME=Assistant Owner
RANMINI_ADMIN_SECONDARY_EMAIL=manager@ranminihardware.lk
RANMINI_ADMIN_SECONDARY_PASSWORD=

# ---------------------------------------------------------------------------
# Password reset by email
#
# Leave SPRING_MAIL_HOST unset and no mail is sent: the reset link is written to
# the service log instead, loudly, so the flow can still be exercised and an
# admin can be helped by hand. Set it and real mail goes out.
#
# For Gmail, the password must be a 16-character App Password (Google account →
# Security → 2-Step Verification → App passwords), never the account password.
#   SPRING_MAIL_HOST=smtp.gmail.com
#   SPRING_MAIL_PORT=587
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# The address staff see the reset email come from.
RANMINI_MAIL_FROM=no-reply@ranminihardware.lk
RANMINI_MAIL_SHOP_NAME=Ranmini Hardware

# Where the link in the email points. Must be the address the shop's browsers
# actually use to reach the frontend, not localhost, once this is deployed.
RANMINI_RESET_URL=http://localhost:3000/admin/reset-password

# How long a reset link stays valid, and how many may be requested per email
# address or caller address inside the window.
RANMINI_AUTH_RESET_MINUTES=45
RANMINI_AUTH_RESET_ATTEMPTS=5
RANMINI_AUTH_RESET_WINDOW_MINUTES=15
