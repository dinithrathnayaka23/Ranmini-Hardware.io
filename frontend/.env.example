# ---------------------------------------------------------------------------
# Ranmini Hardware — frontend environment template
#
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is git-ignored. NEVER commit real credentials, and never move a
# secret to a NEXT_PUBLIC_* variable — anything with that prefix is inlined
# into the JavaScript bundle and is readable by anyone who opens the site.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot API. Read server-side only (Route Handlers and
# Server Components), so the API may sit on a private network.
API_BASE_URL=http://localhost:8080

# Milliseconds before a backend call is aborted. Optional; defaults to 10000.
API_TIMEOUT_MS=10000
