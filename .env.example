# ===========================================================================
# Ranmini Hardware — environment template
#
#     cp .env.example .env
#
# ONE file for both halves of the system. `.env` is git-ignored; this template
# is the only version that is ever committed, and every secret in it is blank.
# Never put a real value here — put it in `.env`.
#
# HOW EACH SIDE READS IT
#
#   Backend   Spring Boot imports this file directly (see `spring.config.import`
#             in backend/src/main/resources/application.yml). It looks for
#             ./.env and ../.env, so it works whether you run from the repo
#             root or from backend/.
#
#   Frontend  Next.js only reads .env files inside frontend/, so it cannot pick
#             this up on its own. frontend/next.config.ts loads it and adopts
#             ONLY the two variables marked "frontend" below.
#
#             That selectivity is deliberate. The Next.js process has no use for
#             the signing key or the mail password, and a process that never
#             holds a secret cannot leak one.
#
# A real environment variable always beats a line in this file, so a container
# or a systemd unit can supply values without the file existing at all.
#
# RANMINI_AUTH_JWT_SECRET is the only value with no default. Everything else
# below works as it stands for local development.
# ===========================================================================


# ---------------------------------------------------------------------------
# Frontend  (the only two variables the Next.js process is given)
# ---------------------------------------------------------------------------

# Where the browser's server-side calls reach the Spring Boot API. Read in
# Route Handlers and Server Components only, never shipped to the browser, so
# the API may sit on a private network.
API_BASE_URL=http://localhost:8080

# Milliseconds before a backend call is abandoned, so a slow API cannot pile up
# requests. Optional; defaults to 10000.
API_TIMEOUT_MS=10000


# ---------------------------------------------------------------------------
# Backend — service
# ---------------------------------------------------------------------------

# MongoDB connection string, including the database name.
# Local development via docker compose:
#   mongodb://localhost:27017/ranmini_pos
# MongoDB Atlas:
#   mongodb+srv://<user>:<password>@<cluster>/ranmini_pos?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ranmini_pos

# Port the API listens on. Must agree with API_BASE_URL above.
SERVER_PORT=8080

# Comma-separated browser origins allowed to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Set to DEBUG to see the queries this service issues.
APP_LOG_LEVEL=INFO


# ---------------------------------------------------------------------------
# Backend — authentication
# ---------------------------------------------------------------------------

# Signing key for session tokens. At least 32 characters; the service refuses
# to start without it rather than inventing one, because a generated key would
# change on every restart and invalidate every session. Generate one with:
#   openssl rand -base64 48
RANMINI_AUTH_JWT_SECRET=

# How long a signed-in session lasts before the token must be refreshed.
#
# A FALLBACK, not the setting. The shop's own session timeout (Settings ->
# Security, clamped to 5..1440 minutes) is what normally decides; this applies
# only on a fresh database, or if the settings document cannot be read — a
# sign-in must not fail because a preference is unavailable.
RANMINI_AUTH_ACCESS_MINUTES=30
RANMINI_AUTH_REFRESH_DAYS=7


# ---------------------------------------------------------------------------
# Backend — the two owner accounts
#
# Created on a fresh database only, and never overwritten afterwards, so a
# redeploy cannot reset a password that has since been changed. Leave the
# passwords blank and a strong one is generated and printed once at first
# startup — watch the log on that first run.
#
# Changing an email here has no effect on a database that already has these
# accounts. Change it from /admin/profile instead.
# ---------------------------------------------------------------------------
RANMINI_ADMIN_PRIMARY_USERNAME=owner
RANMINI_ADMIN_PRIMARY_NAME=Shop Owner
RANMINI_ADMIN_PRIMARY_EMAIL=owner@ranminihardware.lk
RANMINI_ADMIN_PRIMARY_PASSWORD=

RANMINI_ADMIN_SECONDARY_USERNAME=manager
RANMINI_ADMIN_SECONDARY_NAME=Assistant Owner
RANMINI_ADMIN_SECONDARY_EMAIL=manager@ranminihardware.lk
RANMINI_ADMIN_SECONDARY_PASSWORD=


# ---------------------------------------------------------------------------
# Backend — password reset by email
#
# Leave SPRING_MAIL_HOST unset and no mail is sent: the reset link is written
# to the service log instead, loudly, so the flow can still be exercised and a
# locked-out owner can be helped by hand.
#
# For Gmail the password must be a 16-character App Password (Google account ->
# Security -> 2-Step Verification -> App passwords), never the account
# password, and RANMINI_MAIL_FROM must be that same Gmail address — Gmail will
# not send as an address it has not verified.
#   SPRING_MAIL_HOST=smtp.gmail.com
#   SPRING_MAIL_PORT=587
# ---------------------------------------------------------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# The address staff see the reset email come from.
RANMINI_MAIL_FROM=no-reply@ranminihardware.lk
RANMINI_MAIL_SHOP_NAME=Ranmini Hardware

# Where the link in the email points. Must be the address the shop's browsers
# actually use to reach the frontend, not localhost, once this is deployed.
RANMINI_RESET_URL=http://localhost:3000/admin/reset-password
# The same for cashier accounts that have an email address; the link opens the
# till's own recovery page. Cashiers without an address ask the owner instead.
RANMINI_CASHIER_RESET_URL=http://localhost:3000/cashier/reset-password

# How long a reset link stays valid, and how many may be requested per email
# address or caller address inside the window.
RANMINI_AUTH_RESET_MINUTES=45
RANMINI_AUTH_RESET_ATTEMPTS=5
RANMINI_AUTH_RESET_WINDOW_MINUTES=15
